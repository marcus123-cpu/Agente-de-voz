import 'dotenv/config';
import { chromium } from 'playwright';
const password = process.env.OPERATOR_PASSWORD!;
const shot = process.argv[2]!;
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
page.on('pageerror', (e) => console.log('PAGE ERROR:', e.message.slice(0, 300)));
let polls = 0, missedCalled = false;
const fake = (status: string, extra: Record<string, unknown> = {}) => ({ id: 'fake-2', brainId: 'b', patientName: 'Paciente Exemplo', phone: '+5517900000000', status, startedAt: new Date().toISOString(), answeredAt: status === 'in_progress' ? new Date().toISOString() : null, createdAt: new Date().toISOString(), metadata: { contact_context: 'missed_appointment', appointment: { kind: 'missed', date: '2026-11-05', time: '09:00', specialty: 'Dermatologia', professional: 'Dra. Ana Exemplo' }, ...extra } });
await page.route('**/api/amei/missed/call', (route) => { missedCalled = true; route.fulfill({ status: 201, contentType: 'application/json', body: JSON.stringify({ success: true, call: fake('connecting') }) }); });
await page.route('**/api/calls/fake-2', (route) => { polls++; route.fulfill({ contentType: 'application/json', body: JSON.stringify({ call: fake(polls < 2 ? 'ringing' : 'in_progress', polls >= 3 ? { missed: { outcome: 'lista_espera' } } : {}) }) }); });
await page.goto('http://localhost:5173/');
await page.waitForTimeout(2000);
await page.locator('input[type=password]').fill(password);
await page.getByRole('button', { name: /entrar/i }).click();
await page.getByRole('button', { name: /Confirmar agenda/ }).click();
const dates = page.locator('input[type=date]');
await dates.nth(0).fill('2026-11-05'); await dates.nth(1).fill('2026-11-07');
await page.locator('select').filter({ has: page.locator('option', { hasText: 'Faltosos' }) }).selectOption({ label: 'Faltosos (não compareceu, desmarcou ou cancelado)' });
console.log('dica Faltosos visível:', await page.locator('.confirm-hint').count());
await page.getByRole('button', { name: /Pesquisar/ }).click();
await page.locator('table tbody tr').first().waitFor({ timeout: 30000 });
console.log('resumo:', (await page.locator('.confirm-summary').innerText()).replace(/\s+/g, ' ').slice(0, 120));
const tags = await page.locator('table tbody tr td:nth-child(6) .tag').allTextContents();
console.log('status na tela (10 primeiras):', [...new Set(tags)].join(' | '));
const btn = page.locator('.icon-call').first();
console.log('botão ligar habilitado em faltoso:', await btn.isEnabled());
page.once('dialog', (d) => { console.log('DIALOG:', d.message().replace(/\(\d\d\) [\d-]+/, '(**) ****').slice(0, 260)); void d.accept(); });
await btn.click();
await page.waitForTimeout(8000);
console.log('rota de faltoso chamada:', missedCalled);
console.log('widget:', (await page.locator('.call-widget').allTextContents()).join(' ').slice(0, 220));
await page.screenshot({ path: shot });
await browser.close();
